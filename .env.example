# ==========================================================================
# 合同审批智能审查系统 —— 环境变量示例
#
# 用法：复制为 .env 后按需修改（.env 已在 .gitignore 里，不会提交）
#     copy .env.example .env          # Windows CMD
#     cp .env.example .env            # Git Bash
# ==========================================================================

# ------------------------- 数据库（Docker MySQL）-------------------------
# 方案 A（默认，推荐）：用本项目自带的容器
#     docker compose up -d mysql
#   容器里已经建好 contract_review 库，端口映射到宿主机的 3307
APP_DB_URL=mysql+asyncmy://contract:contract123@127.0.0.1:3307/contract_review?charset=utf8mb4

# 方案 B：复用你既有的 MySQL（3306 那套 RAG 栈）
#   先建库：CREATE DATABASE contract_review DEFAULT CHARSET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   再把这行打开、把方案 A 注释掉，账号密码换成你那套的
# APP_DB_URL=mysql+asyncmy://root:你的密码@127.0.0.1:3306/contract_review?charset=utf8mb4

# 打印 SQL（排查问题时打开）
APP_DB_ECHO=false
# 启动时自动建表
APP_DB_AUTO_CREATE=true

# ------------------------------- 服务 ------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=false

# ---------------------- 大模型（OpenAI 兼容协议）-------------------------
# 关掉的话系统只用规则引擎，功能完整但少了语义研判与条款改写
APP_LLM_ENABLED=false
APP_LLM_BASE_URL=https://api.openai.com/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=gpt-4o-mini
APP_LLM_TEMPERATURE=0.1
APP_LLM_TIMEOUT=120

# 如果你用的是国内网关（DeepSeek / 通义 / 智谱等），把 base_url 改成对应地址即可，例如：
#   DeepSeek   APP_LLM_BASE_URL=https://api.deepseek.com/v1   APP_LLM_MODEL=deepseek-chat
#   通义千问   APP_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   APP_LLM_MODEL=qwen-plus

# -------------------------------- OCR -------------------------------------
# 扫描件识别。装依赖：uv sync --extra ocr
APP_OCR_ENABLED=true
# PDF 单页可抽取文本少于此值，视为扫描页，自动转 OCR
APP_PDF_PAGE_TEXT_THRESHOLD=30

# --------------------------- 解析完整性阈值 -------------------------------
# 正文低于此字数判定为「正文为空」→ 任务置 blocked
APP_MIN_BODY_CHARS=50
# 单一字符占比超过此值判定为乱码/水印 → blocked
APP_GIBBERISH_RATIO=0.6
